// Copy to Secrets.xcconfig (gitignored) and fill in.
//
//     cp FantasyWatch/Config/Secrets.example.xcconfig \
//        FantasyWatch/Config/Secrets.xcconfig
//
// LAMBDA_BASE_URL is the ScoreUrl output of `sam deploy`, with the trailing
// slash removed. Write "//" as $(SLASH)$(SLASH): an xcconfig would otherwise
// read the rest of the line as a comment.
//
// CLIENT_API_KEY is the ClientApiKey parameter you passed to `sam deploy`.

LAMBDA_BASE_URL = https:$(SLASH)$(SLASH)REPLACEME.lambda-url.us-east-1.on.aws
CLIENT_API_KEY = REPLACEME
